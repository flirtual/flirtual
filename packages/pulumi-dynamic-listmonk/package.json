{
	"name": "@flirtual/pulumi-dynamic-listmonk",
	"private": true,
	"description": "Pulumi dynamic resources for Listmonk, driven through its REST API.",
	"type": "module",
	"exports": "./src/index.ts",
	"scripts": {
		"generate:api": "typed-openapi https://raw.githubusercontent.com/knadh/listmonk/v6.2.0/docs/swagger/collections.yaml --no-include-client -o src/generated/index.ts",
		"postinstall": "pnpm generate:api",
		"test": "vitest run",
		"build": "tsc",
		"lint": "oxlint && oxfmt --check",
		"fmt": "oxfmt"
	},
	"dependencies": {
		"@flirtual/pulumi-dynamic-fetch": "workspace:*"
	},
	"devDependencies": {
		"@flirtual/config": "workspace:*",
		"@pulumi/pulumi": "catalog:pulumi",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typed-openapi": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@pulumi/pulumi": "catalog:pulumi"
	}
}
