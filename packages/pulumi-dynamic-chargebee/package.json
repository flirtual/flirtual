{
	"name": "@flirtual/pulumi-dynamic-chargebee",
	"private": true,
	"description": "Pulumi dynamic resources for Chargebee, typed from its OpenAPI spec.",
	"type": "module",
	"exports": "./src/index.ts",
	"scripts": {
		"generate:api": "typed-openapi https://raw.githubusercontent.com/chargebee/openapi/06f6ff8a4dd98577961acb29bf1d2d0c41684748/spec/chargebee_api_v2_pc_v2_spec.json --no-include-client -o src/generated/index.ts",
		"postinstall": "pnpm generate:api",
		"test": "vitest run",
		"build": "tsc",
		"lint": "oxlint && oxfmt --check",
		"fmt": "oxfmt"
	},
	"dependencies": {
		"@flirtual/pulumi-dynamic-fetch": "workspace:*"
	},
	"devDependencies": {
		"@flirtual/config": "workspace:*",
		"@pulumi/pulumi": "catalog:pulumi",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typed-openapi": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@pulumi/pulumi": "catalog:pulumi"
	}
}
