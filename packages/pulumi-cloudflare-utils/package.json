{
	"name": "@flirtual/pulumi-cloudflare-utils",
	"private": true,
	"description": "Pulumi dynamic resources for Cloudflare Workers, deployed from cf Build Output through the cf CLI.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./providers/*": "./src/providers/*.ts"
	},
	"scripts": {
		"test": "vitest run",
		"build": "tsc",
		"lint": "oxlint && oxfmt --check",
		"fmt": "oxfmt"
	},
	"dependencies": {
		"@cloudflare/build-output-utils": "catalog:",
		"@cloudflare/config": "catalog:",
		"@flirtual/pulumi-utils": "workspace:*",
		"cf": "catalog:",
		"execa": "catalog:"
	},
	"devDependencies": {
		"@flirtual/config": "workspace:*",
		"@pulumi/pulumi": "catalog:",
		"@types/node": "^22",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@pulumi/pulumi": "catalog:"
	}
}
