{
	"name": "@flirtual/pulumi-dynamic-revenuecat",
	"private": true,
	"description": "Pulumi dynamic resources for RevenueCat, typed from its OpenAPI spec.",
	"type": "module",
	"exports": "./src/index.ts",
	"scripts": {
		"generate:api": "node scripts/generate-api.ts",
		"postinstall": "pnpm generate:api",
		"test": "vitest run",
		"build": "tsc",
		"lint": "oxlint && oxfmt --check",
		"fmt": "oxfmt"
	},
	"dependencies": {
		"@flirtual/pulumi-dynamic-fetch": "workspace:*"
	},
	"devDependencies": {
		"@flirtual/config": "workspace:*",
		"@pulumi/pulumi": "catalog:pulumi",
		"@types/node": "catalog:",
		"marked": "18.0.14",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"typed-openapi": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"yaml": "catalog:pulumi"
	},
	"peerDependencies": {
		"@pulumi/pulumi": "catalog:pulumi"
	}
}
