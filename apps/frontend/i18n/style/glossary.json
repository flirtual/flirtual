			"status": "decided",
			"terms": {
				"de": {
					"term": "Kumpel-Modus"
				},
				"es": {
					"term": "Modo Amigos"
				},
				"fr": {
					"term": "Mode Potes"
				},
				"nl": {
					"term": "Maatjesmodus"
				},
				"pt": {
					"term": "Modo Amigos",
					"status": "provisional"
				},
				"pt-BR": {
					"term": "Modo Amigos"
				},
				"ru": {
					"term": "Режим друзей",
					"status": "provisional"
				},
				"sv": {
					"term": "Kompisläge"
