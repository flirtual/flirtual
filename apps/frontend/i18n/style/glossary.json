{
	"$comment": "Source of truth for terminology, synced to the Weblate glossary by `weblate.ts glossary`. `match` is a regex over the English (flags in `matchFlags`); `terms[locale].term` is required when it matches (validator warning), `forbidden` substrings are validator errors. `status`: decided (maintainer), provisional (maintainer, awaiting a native reviewer), proposed (Claude, unconfirmed).",
	"entries": [
		{
			"id": "flirtual",
			"en": "Flirtual",
			"note": "The app's name. Never translate, transliterate or inflect it in a way that changes its spelling.",
			"untranslatable": true,
			"match": "\\bFlirtual\\b",
			"forbidden": {
				"ja": [
					"フラーチュアル",
					"フラーチャル"
				],
				"ko": [
					"플러추얼",
					"플러티얼"
				],
				"ru": [
					"Флиртуал"
				]
			}
		},
		{
			"id": "flitty",
			"en": "Flitty",
			"note": "Flirtual's cat mascot (the homepage cat, and the April Fools 2025 dating assistant). A name: keep it in Latin script.",
