				"ja": [
					"ホーミー",
					"Homie"
				],
				"ko": [
					"호미",
					"Homie"
				],
				"pt": [
					"amigar",
					"amigou",
					"amigando"
				],
				"*": [
					"Homie"
				]
			}
		},
		{
			"id": "homie",
			"en": "Homie",
			"note": "The browse action/button that signals friend interest (pairs with Like for romantic interest). Also used as a noun (\"Send a Homie\") and verb (\"homied you\"). Phrase so no gender agreement is needed; fr: no inclusive writing (point médian), rephrase instead (« veut être pote avec toi »).",
			"match": "\\b[Hh]omie(?:d|s|-ing)?\\b(?! Mode)",
			"status": "decided",
			"terms": {
				"de": {
					"term": "Kumpel"
				},
				"es": {
					"term": "Amistad",
					"note": "Button; lists use Amigos. Spain and Latin America.",
					"status": "provisional"
				},
				"fr": {
					"term": "Pote"
				},
				"nl": {
					"term": "Maatje"
				},
				"pt": {
					"term": "Amizade",
					"note": "Button; verb phrasing with \"fazer amizade\" (\"quer fazer amizade contigo\"); lists use Amigos",
					"status": "provisional"
				},
				"pt-BR": {
					"term": "Amigar",
					"note": "Verb (amigar, amigou); lists use Amigos",
					"status": "provisional"
				},
				"ru": {
					"term": "Дружить",
					"note": "Button is the verb; \"хочет дружить с вами\"",
					"status": "provisional"
