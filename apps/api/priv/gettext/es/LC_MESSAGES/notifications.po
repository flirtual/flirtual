#: lib/flirtual/user/email.ex:399
#, elixir-autogen, elixir-format, fuzzy
msgid "deletion_reminder_723.body_html"
msgstr ""
"<p><strong>Este es tu último recordatorio.</strong> Tu cuenta de Flirtual se "
"eliminará de forma permanente en 7 días.</p><p>Solo tienes que iniciar "
"sesión una vez en los próximos 7 días para evitar que se elimine tu cuenta: "
