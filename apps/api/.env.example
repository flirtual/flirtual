# Environment variables used by the API application.
# Used only for local development, production values are expected to be set by the host environment.

# Discord OAuth2 credentials.
# See https://discord.com/developers/applications
# export DISCORD_CLIENT_ID=""
# export DISCORD_CLIENT_SECRET=""
# export DISCORD_ACCESS_TOKEN=""

# Discord webhook credentials, used for logging.
# See https://support.discord.com/hc/en-us/articles/228383668-Intro-to-Webhooks

## If left empty, logging to that webhook will be disabled.
## Expected format: 123456789012345678/abcdefghijklmnopqrstuvwxyz
# export DISCORD_WEBHOOK_MODERATION_REPORTS=""
# export DISCORD_WEBHOOK_MODERATION_FLAGS=""
# export DISCORD_WEBHOOK_MODERATION_DUPLICATES=""
# export DISCORD_WEBHOOK_MODERATION_PICS=""
# export DISCORD_WEBHOOK_MODERATION_ACTIONS=""
# export DISCORD_WEBHOOK_MODERATION_ACKNOWLEDGEMENTS=""
# export DISCORD_WEBHOOK_ADMIN=""

# Talk.js credentials, used for chat.
# See https://talkjs.com/dashboard/

## Required to authenticate requests with the Talk.js API.
## Must match the "NEXT_PUBLIC_TALKJS_APP_ID" value in apps/frontend/.env.local.
## Expected format: "abcdefgh"
# export TALKJS_APP_ID=""
## Used to authenticate requests to the Talk.js API.
## Expected format: "sk_live_abcdefghijklmnopqrstuvwxyz"
# export TALKJS_ACCESS_TOKEN=""

# Cloudflare Turnstile credentials, used for registration captcha.
# See https://developers.cloudflare.com/turnstile/

## Required to authenticate requests to the Turnstile API.
## Must match the "NEXT_PUBLIC_TURNSTILE_SITE_KEY" value in apps/frontend/.env.local.
## Expected format: "0xabcdefghijklmnopqrstuv"
# export TURNSTILE_APP_ID=""
## Used to verify that the token was generated by the Turnstile service.
## Expected format: "0xabcdefghijklmnopqrstuvwxyzabcdefg"
# export TURNSTILE_ACCESS_TOKEN="1x0000000000000000000000000000000AA"

# Freshdesk credentials, used to file ban appeals as tickets.
# See https://developers.freshdesk.com/api/#authentication

## The account's Freshdesk domain.
## Expected format: "example.freshdesk.com"
# export FRESHDESK_DOMAIN=""
## An agent's API key, from Freshdesk under Profile settings.
## Expected format: "abcdefghijklmnopqrs"
# export FRESHDESK_API_KEY=""
## The group ban appeals are optionally assigned to, by numeric id.
## Expected format: "1234567890"
# export FRESHDESK_MODERATION_GROUP_ID=""

# Yoti credentials, used for age verification.
# See https://developers.yoti.com/age-verification/onboarding

## The SDK ID of the Yoti service, from Yoti Hub.
## Expected format: "00000000-0000-0000-0000-000000000000"
# export YOTI_SDK_ID=""
## The PEM private key paired with the SDK ID, used to mint OAuth access tokens.
## Required for the sandbox, which has no API keys.
# export YOTI_PRIVATE_KEY=""
## The API key. Used instead of the private key when set.
# export YOTI_API_KEY=""
## Target the sandbox instead of live. Defaults to true outside production.
# export YOTI_SANDBOX="true"
## The public key notification signatures are verified against.
## Sandbox key, from:
## https://developers.yoti.com/age-verification/sandbox-notifications
# export YOTI_NOTIFICATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAwVQ840btpD7bmLW0+tS5
# yZOCdhaRV7/uJ4X6BhgnaArwcvdMS3VjjcDICo2e2OZDySpsb2b97DGjYTpWNEAQ
# CtU9/Ye0mXlsmfYX8lmzPm5P98EEkqyOF+RWmykbhA8hMrgI9ykqsSoAbCCAhPh1
# 0J9ugLJVIokEv1o3bnRk3PboUQBHKBunWb1Da7U7X/Feb5RyHG3ksVOKfBOu3AKS
# /GobJg/95oo/d79X+7P+e1Z3fdmkmdxMqr/tTs5cj2sKUZPwERpTJYyMCLXMsswn
# 8ms4jawVcRKyxP1GfPqqc13edwVH49Ial8pjXEpB50G2Wk9yvODvB2cEGeeEJcFI
# oQIDAQAB
# -----END PUBLIC KEY-----"
## Live key, from:
## https://developers.yoti.com/age-verification/notifications
# export YOTI_NOTIFICATION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIBojANBgkqhkiG9w0BAQEFAAOCAY8AMIIBigKCAYEAune8+8vPz/pQD6IzdWvX
# Q66nh/RcywopCI01Wjo6i7vlH2iVOP1oCkgbObe12iMmVXKRiXgMNT6aXIGe6Ggw
# dodzAmt3vT1fmrgub7Of6MgJ56ri2uH1O54DTjbnEbEcLXX13teOusZavntrkNpp
# x1c8L0Ol41mRvImJeMHM6I16rLhqB/w1m7USMvof/K6GaP+VmmciZTPyZ6IsXxvB
# k0ZoqWqrt2xENlg4O6LXMo7eHEiG+edm9uDpbZK1RhiCd6hyDZ/t4bBQNg4misFF
# WezQSiUlPwBLRg1AJ3CNrtBzs49BZ30U7WSPUS0Gsq1lhhDtUtJUt4CdkDAfkVY6
# 2C6aaqKV940GcPFN7MjOeFus3VNJE3zyHVLT8DStuLMXHY+gQBGFOyxN6heZbm7a
# Sl9fi7VXlDTlv1jpk4DFMQYF2fpAyomm95GavhllJnDxC2t8ebu0O23B88hPGI3K
# kyLtPA8ie6UNmwNqLYpOEN/pwayYw75FcENBDxnWhoe9AgMBAAE=
# -----END PUBLIC KEY-----"

# Chargebee credentials, used for payments.

## Chargebee subdomain.
# export CHARGEBEE_NAMESPACE=""
## Used to create and manage subscriptions.
# export CHARGEBEE_ACCESS_TOKEN=""
## This signing secret is used to verify that webhooks are sent by Chargebee.
## Expected format: base64 username:password
# export CHARGEBEE_SIGNING_SECRET=""

# RevenueCat credentials, used for payments.

## Used to create and manage subscriptions.
## Expected format: "sk_abcdefghijklmnopqrstuvwxyzabc"
# export REVENUECAT_ACCESS_TOKEN=""
## Client SDK keys required by some endpoints
## Expected format: "appl_abcdefghijklmnopqrstuvwxyza"
# export REVENUECAT_APPLE_KEY=""
## Expected format: "appl_abcdefghijklmnopqrstuvwxyza"
# export REVENUECAT_GOOGLE_KEY=""
## This signing secret is used to verify that webhooks are sent by RevenueCat.
# export REVENUECAT_SIGNING_SECRET=""

# Listmonk credentials, used for marketing emails.
# export LISTMONK_URL=""
# export LISTMONK_USERNAME=""
# export LISTMONK_PASSWORD=""

# Apple credentials, used for sign-in and push notifications.
# Expected format: "-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"
# export APPLE_KEY=""
# Expected format: "ABCDEFGHIJ"
# export APPLE_KEY_ID=""
# Expected format: "ABCDEFGHIJ"
# export APPLE_TEAM_ID=""

# Bundle and Sign In with Apple service IDs
# export APPLE_SIGNIN_APP_ID=""
# export APPLE_SIGNIN_SERVICE_ID=""

# Google OAuth clients, used for Google sign-in.
# See https://console.cloud.google.com/apis/credentials
# export GOOGLE_CLIENT_ID=""
# export GOOGLE_CLIENT_SECRET=""
# export GOOGLE_IOS_CLIENT_ID=""

# Meta credentials, used for Meta Horizon Account Linking.
# See https://developers.meta.com/horizon/documentation/android-apps/ps-account-linking/
# export META_APP_ID=""
# export META_APP_SECRET=""
# export META_ORGANIZATION_ID=""

# Generally the bundle ID
# export APNS_TOPIC=""

# FCM service account, used for Android push notifications.
# export FCM_PROJECT_ID=""
# Expected format: '{
# ...
# }'
# export GOOGLE_APPLICATION_CREDENTIALS_JSON=''

# VRChat credentials, used for account connection
# See https://vrchat.community/
# export VRCHAT_USERNAME=""
# export VRCHAT_PASSWORD=""
# export VRCHAT_TOTP_SECRET=""

# OpenAI credentials, used for text moderation.
# export OPENAI_ORG_ID=""
# export OPENAI_ACCESS_TOKEN=""

# Sentry credentials, used for error reporting.
# export SENTRY_DSN=""
# export SENTRY_TRACES="0.1"
# export SENTRY_LOGS="1"
# export TELEMETRY="1"

# Worker rate limits, # per second
# export EMAIL_RATE_LIMIT=1

# Amazon SES configuration, used for sending emails.
# export SES_REGION=""
# export SES_ACCESS_KEY=""
# export SES_SECRET=""
# export MAIL_DOMAIN_TRANSACTIONAL=""
# export MAIL_DOMAIN_MARKETING=""
# export MAIL_REPLY_DOMAIN=""
# export SES_CONFIGURATION_SET_TRANSACTIONAL="account"
# export SES_CONFIGURATION_SET_MARKETING="notify"

# Cloudflare R2 credentials and URLs, used for image uploads.
# export R2_HOSTNAME=""
# export R2_ACCESS_KEY_ID=""
# export R2_SECRET_ACCESS_KEY=""
# export BUCKET_CONTENT_ORIGIN=""
# export BUCKET_UPLOADS_ORIGIN=""
# export BUCKET_RETAINED_ORIGIN=""

# tus server, used for resumable image uploads. Defaults to FRONTEND_ORIGIN.
# export UPLOAD_ORIGIN=""
# Base64, must equal the tus server's SHARED_AUTH_SECRET.
# export UPLOAD_SECRET=""

# Image Classification service, used for image search.
# export IMAGE_CLASSIFICATION_ORIGIN="https://$(hostname):8080"

# Scan queue access token, used by the Image Variant and Image Classification services.
# Must match the "ACCESS_TOKEN" value in apps/image-classification/.env.local.
# export IMAGE_ACCESS_TOKEN="local_lk8agDaGutgEWwTBssV2f1Y0bOctRAHa89AZgmjFUh462F0N32tPwTjtynG"

# Profile feedback access token, used by the Discord bot.
# Must match the "FLIRTUAL_ACCESS_TOKEN" value in flirtualbot.
# export FEEDBACK_ACCESS_TOKEN="local_u3HxXMz7yp0KxkewdJkUQQSCjZJZLehA6TFdgpQaKj8Zxmo4OxIygcUWvhy"

# stereo2spatial service, used by the spatial HEIC processing service.
# export STEREO2SPATIAL_ORIGIN="https://stereo2spatial.kfarwell.org"
# export STEREO2SPATIAL_ACCESS_TOKEN=""

# Android custom_url_scheme, used for OAuth redirect.
# export APP_SCHEME="flirtual-beta"

# Miscellaneous variables.
# export ROOT_ORIGIN="https://$(hostname):3000"
# export FRONTEND_ORIGIN="https://$(hostname):3000"
# export ORIGIN="https://$(hostname):4001"
# export WEBAUTHN_RP_ID="flirtu.al"
# export SESSION_SIGNING_SALT="local_M0aOkiQYko"
# export LIVE_VIEW_SIGNING_SALT="local_gwbAO9QRWu"
# export SECRET_KEY_BASE="local_1TGGlvHyCZNDDLHq2HEwlFhrNZ519f0XT8MHIqAE4UcbdMEuHz0zr5zo0thFfbsTrFmkZ5G955hEau2jAA"
# export JOKEN_SECRET="local_Ru3m3hN7uAxO2snCb030SDyzDyR"
