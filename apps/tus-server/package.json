{
	"name": "tus-server",
	"version": "0.15.0",
	"type": "module",
	"private": true,
	"license": "AGPL-3.0-only",
	"scripts": {
		"typegen": "wrangler types",
		"type-check": "pnpm typegen && tsc",
		"build": "pnpm typegen && wrangler deploy --dry-run --outdir=dist",
		"build:cloudflare": "cf-wrangler build --mode development",
		"pretest": "pnpm typegen",
		"test": "vitest run",
		"dev": "wrangler dev",
		"deploy:canary": "wrangler deploy --env=canary",
		"deploy:production": "wrangler deploy --env=production"
	},
	"dependencies": {
		"signal-tus-server": "github:signalapp/tus-server#34f243a7be536679483374d314b556801bc0a2f5"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "catalog:",
		"@types/node": "catalog:",
		"cf": "catalog:",
		"jose": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
