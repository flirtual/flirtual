		"jose": "^6.2.2"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "catalog:",
		"@types/node": "^25.5.0",
		"tus-js-client": "^4.3.1",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
