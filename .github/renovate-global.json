{
	"$schema": "https://docs.renovatebot.com/renovate-global-schema.json",
	"repositories": ["flirtual/flirtual"],
	"binarySource": "global",
	"allowedCommands": [
		"^pnpm install --frozen-lockfile --ignore-scripts --filter frontend$",
		"^pnpm --config.verify-deps-before-run=false --dir apps/frontend exec cap update$"
	],
	"customEnvVariables": {
		"CAPACITOR_UPDATE_ONLY": "1"
	}
}
